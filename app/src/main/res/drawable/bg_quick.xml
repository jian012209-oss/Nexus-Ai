<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#40FF2E2E" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/cyan" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#2EFF2E2E" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/cyan" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/glass" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/glass_line" /></shape>
    </item>
</selector>
