<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.22"
                android:text="J.A.R.V.I.S."
                android:textColor="@color/cyan"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.06"
                android:text="@string/tagline"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/modeChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="● HYBRID · ONLINE"
            android:textColor="@color/cyan"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/menuBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu"
            app:tint="@color/text" />
    </LinearLayout>

    <!-- Device status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:text="12:00 PM"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuesday, Nov 10"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:text="--%"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/chargeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/controlText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="Off"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone control"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/accBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_warn"
        android:padding="10dp"
        android:text="Phone control is off. Tap here so I can go home, go back, lock the screen, scroll and tap for you."
        android:textColor="@color/amber"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- TODAY: your to-do list -->
    <LinearLayout
        android:id="@+id/todayCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/todayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="TODAY"
                android:textColor="@color/amber"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/todayAdd"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="+ Add"
                android:textColor="@color/cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/todayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- AI core -->
    <com.jarvis.ai.CoreView
        android:id="@+id/core"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="6dp"
        android:contentDescription="AI core. Tap to talk." />

    <com.jarvis.ai.WaveView
        android:id="@+id/wave"
        android:layout_width="180dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:text="TAP THE CORE TO TALK"
        android:textColor="@color/cyan"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/partialText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="18dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:textStyle="italic" />

    <!-- Quick controls (filled in code) -->
    <LinearLayout
        android:id="@+id/quickRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <!-- Recent commands -->
    <HorizontalScrollView
        android:id="@+id/recentScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/recentRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Conversation -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp" />
    </ScrollView>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/alwaysSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Always ready: say “Hey Jarvis”"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <!-- Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Type a command or question"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send"
            android:src="@drawable/ic_send"
            app:tint="@color/cyan" />

        <ImageButton
            android:id="@+id/micBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mic"
            android:contentDescription="Talk"
            android:src="@drawable/ic_mic"
            app:tint="@color/bg" />
    </LinearLayout>
</LinearLayout>
